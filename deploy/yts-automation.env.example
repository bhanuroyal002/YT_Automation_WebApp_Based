# Copy to /etc/yts-automation/yts-automation.env and edit for the deployment.
# Do not commit real secrets or credentials.

HOST=127.0.0.1
PORT=5000
LOG_LEVEL=INFO
FLASK_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Browser origin(s) allowed to call the API. Use the real HTTPS hostname.
ALLOWED_ORIGINS=https://yts.example.com

# Optional network ADB target, for example 10.20.0.15:5555.
# Leave empty when multiple DUTs are discovered normally.
ADB_DEVICE=
ADB_PATH=/usr/bin/adb

YTS_DOWNLOAD_URL=http://yts.devicecertification.youtube/yts_server.zip
YTS_DOWNLOAD_TIMEOUT=120
MAX_COMPLETED_SESSIONS=100
