[Unit]
Description=YTS Automation Web Application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yts
Group=yts
WorkingDirectory=/opt/yts-automation
EnvironmentFile=/etc/yts-automation/yts-automation.env
ExecStart=/opt/yts-automation/.venv/bin/gunicorn --config /opt/yts-automation/deploy/gunicorn.conf.py app:app
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/yts-automation/data /tmp

[Install]
WantedBy=multi-user.target
